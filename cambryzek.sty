\newcommand{\curl}{\nabla \times} % curl

%% integrals
\newcommand{\intinf}{\int_{-\infty}^{\infty}}
\newcommand{\intzinf}{\int_{0}^{\infty}}

%% unit vectors
\makeatletter
\DeclareRobustCommand{\uvec}[1]{{
  \ifcat\relax\noexpand#1
    \edef\uvec@name{\expandafter\@gobble\string#1}
    \ifcsname up\uvec@name\endcsname
      \bm{\hat{\csname up\uvec@name\endcsname}}
    \else
      \bm{\hat{#1}}
    \fi
  \else
    \ifcsname uvec#1\endcsname
      \csname uvec#1\endcsname
    \else
      \bm{\hat{\mathbf{#1}}}
    \fi
  \fi
}}
\makeatother

