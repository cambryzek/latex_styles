%% cref names
\crefname{figure}{Fig.}{Figs.}
\Crefname{figure}{Figure}{Figures}
\crefname{table}{Tab.}{Tabs.}
\Crefname{table}{Table}{Tables}
\crefname{section}{Sec.}{Secs.}
\Crefname{section}{Section}{Sections}
\crefname{chapter}{Ch.}{Chs.}
\Crefname{chapter}{Chapter}{Chapters}
\crefname{appendix}{App.}{Apps.}
\Crefname{appendix}{Appendix}{Appendices}
\crefname{theorem}{Thm.}{Thms.}
\Crefname{theorem}{Theorem}{Theorems}
\crefname{definition}{Def.}{Defs.}
\Crefname{definition}{Definition}{Definitions}

%% cref formats
\crefformat{figure}{#2\textcolor{black}{Fig.}~#1#3}
\Crefformat{figure}{#2\textcolor{black}{Figure}~#1#3}
\crefformat{table}{#2\textcolor{black}{Tab.}~#1#3}
\Crefformat{table}{#2\textcolor{black}{Table}~#1#3}
\crefformat{section}{#2\textcolor{black}{Sec.}~#1#3}
\Crefformat{section}{#2\textcolor{black}{Section}~#1#3}
\crefformat{chapter}{#2\textcolor{black}{Ch.}~#1#3}
\Crefformat{chapter}{#2\textcolor{black}{Chapter}~#1#3}
\crefformat{appendix}{#2\textcolor{black}{App.}~#1#3}
\Crefformat{appendix}{#2\textcolor{black}{Appendix}~#1#3}
\crefformat{theorem}{#2\textcolor{black}{Thm.}~#1#3}
\Crefformat{theorem}{#2\textcolor{black}{Theorem}~#1#3}
\crefformat{definition}{#2\textcolor{black}{Def.}~#1#3}
\Crefformat{definition}{#2\textcolor{black}{Definition}~#1#3}
\crefformat{equation}{#2\textcolor{black}{Eq.}~(#1)#3}
\Crefformat{equation}{#2\textcolor{black}{Equation}~(#1)#3}

%% multi-reference formats (\cref{a,b,c})
\crefmultiformat{figure}%
  {#2\textcolor{black}{Figs.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{figure}%
  {#2\textcolor{black}{Figures}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{table}%
  {#2\textcolor{black}{Tabs.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{table}%
  {#2\textcolor{black}{Tables}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{section}%
  {#2\textcolor{black}{Secs.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{section}%
  {#2\textcolor{black}{Sections}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{chapter}%
  {#2\textcolor{black}{Chs.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{chapter}%
  {#2\textcolor{black}{Chapters}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{appendix}%
  {#2\textcolor{black}{Apps.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{appendix}%
  {#2\textcolor{black}{Appendices}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{theorem}%
  {#2\textcolor{black}{Thms.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{theorem}%
  {#2\textcolor{black}{Theorems}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{definition}%
  {#2\textcolor{black}{Defs.}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\Crefmultiformat{definition}%
  {#2\textcolor{black}{Definitions}~#1#3}{\crefpairconjunction#2#1#3}%
  {\crefmiddleconjunction#2#1#3}{\creflastconjunction#2#1#3}
\crefmultiformat{equation}%
  {#2\textcolor{black}{Eqs.}~(#1)#3}{\crefpairconjunction#2(#1)#3}%
  {\crefmiddleconjunction#2(#1)#3}{\creflastconjunction#2(#1)#3}
\Crefmultiformat{equation}%
  {#2\textcolor{black}{Equations}~(#1)#3}{\crefpairconjunction#2(#1)#3}%
  {\crefmiddleconjunction#2(#1)#3}{\creflastconjunction#2(#1)#3}

%% range formats (\crefrange{a}{b})
\crefrangeformat{figure}{#3\textcolor{black}{Figs.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{figure}{#3\textcolor{black}{Figures}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{table}{#3\textcolor{black}{Tabs.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{table}{#3\textcolor{black}{Tables}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{section}{#3\textcolor{black}{Secs.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{section}{#3\textcolor{black}{Sections}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{chapter}{#3\textcolor{black}{Chs.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{chapter}{#3\textcolor{black}{Chapters}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{appendix}{#3\textcolor{black}{Apps.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{appendix}{#3\textcolor{black}{Appendices}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{theorem}{#3\textcolor{black}{Thms.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{theorem}{#3\textcolor{black}{Theorems}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{definition}{#3\textcolor{black}{Defs.}~#1#4\crefrangeconjunction#5#2#6}
\Crefrangeformat{definition}{#3\textcolor{black}{Definitions}~#1#4\crefrangeconjunction#5#2#6}
\crefrangeformat{equation}{#3\textcolor{black}{Eqs.}~(#1)#4\crefrangeconjunction#5(#2)#6}
\Crefrangeformat{equation}{#3\textcolor{black}{Equations}~(#1)#4\crefrangeconjunction#5(#2)#6}


