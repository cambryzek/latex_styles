%% vectors
\makeatletter
\newcommand{\vb}[1]{
  \edef\vb@name{\expandafter\@gobble\string#1}
  \ifcsname up\vb@name\endcsname
    \boldsymbol{\csname up\vb@name\endcsname}
  \else
    \boldsymbol{\mathbf{#1}}
  \fi
}

%% greek
\DeclareMathAlphabet{\bbgreek}{U}{bbold}{m}{n}
\@namedef{mb@ugreek@Gamma}{}\@namedef{mb@ugreek@Delta}{}\@namedef{mb@ugreek@Theta}{}
\@namedef{mb@ugreek@Lambda}{}\@namedef{mb@ugreek@Xi}{}\@namedef{mb@ugreek@Pi}{}
\@namedef{mb@ugreek@Sigma}{}\@namedef{mb@ugreek@Upsilon}{}\@namedef{mb@ugreek@Phi}{}
\@namedef{mb@ugreek@Psi}{}\@namedef{mb@ugreek@Omega}{}

%% matrices
\newcommand{\mb}[1]{
  \edef\vb@name{\expandafter\@gobble\string#1}
  \ifcsname mb@ugreek@\vb@name\endcsname
    \bbgreek{#1}
  \else\ifcsname up\vb@name\endcsname
    \boldsymbol{\csname up\vb@name\endcsname}
  \else
    \boldsymbol{\mathbb{#1}}
  \fi\fi
}
\makeatother

