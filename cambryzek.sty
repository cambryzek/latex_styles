%% derivatives
\newcommand{\dd}[2]{\frac{\rd #1}{\rd #2}}
\newcommand{\ddt}[2]{\frac{\rd^2 #1}{\rd #2^2}}
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\pdt}[2]{\frac{\partial^2 #1}{\partial #2^2}}
\newcommand{\diff}[1]{\frac{\rd}{\rd #1}}
\newcommand{\ddiff}[1]{\frac{\rd^2}{\rd #1^2}}
\newcommand{\pdiff}[1]{\frac{\partial}{\partial #1}}
\newcommand{\pddiff}[1]{\frac{\partial^2}{\partial #1^2}}
